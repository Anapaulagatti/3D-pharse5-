{
  "name": "hangeul-pixel-town",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "assets": "python3 tools/export_world.py && python3 tools/export_actors.py",
    "assets:check": "python3 tools/check_world.py && python3 tools/check_actors.py && python3 tools/check_gwanghwamun.py && python3 tools/check_juni_animation.py && python3 tools/check_living_seoul.py",
    "dev": "vite --host 127.0.0.1 --port 4200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests tools/*.mjs *.ts *.json index.html",
    "format:check": "prettier --check src tests tools/*.mjs *.ts *.json index.html",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && npm run assets:check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4201",
    "assets:chibi": "python3 tools/export_actors.py"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
