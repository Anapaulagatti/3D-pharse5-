  "entrances": [
    {
      "id": "hall",
      "x": 2176,
      "y": 320,
      "text": "궁궐 · Cung điện. Các sân và cổng tạo thứ bậc từ không gian công cộng đến đại điện."
    },
    {
      "id": "hanji",
      "x": 2480,
      "y": 384,
      "text": "한지 · Giấy hanji. Từ sợi dâu đến trang sách: một vật liệu gắn với nghề thủ công Hàn Quốc."
    },
    {
      "id": "royal-garden",
      "x": 1568,
      "y": 528,
      "text": "정자 · Đình nghỉ. Dừng lại bên vườn, nhìn mái giwa và thưởng thức khoảng sân yên tĩnh."
    },
    {
      "id": "science",
      "x": 2656,
      "y": 1472,
      "text": "과학 · Khoa học. Thiên cầu và dụng cụ đo gợi những phát minh quan sát bầu trời."
    },
    {
      "id": "museum",
      "x": 3008,
      "y": 2028,
      "text": "역사 · Lịch sử. Các mô hình hàng hải kể chuyện kỹ nghệ đóng tàu và di sản biển."
    },
    {
      "id": "bookshop",
      "x": 1688,
      "y": 2608,
      "text": "서점 · Hiệu sách. 책 · Sách. Một góc đọc nhỏ nối phố học với hành trình hôm nay."
    },
    {
      "id": "urban-hub",
      "x": 1776,
      "y": 3520,
      "text": "도시 · Đô thị. 유리 · Kính. 콘크리트 · Bê tông. Cửa kính rộng và kết cấu thép đánh dấu nhịp sống hiện đại."
    },
    {
      "id": "tower",
      "x": 704,
      "y": 3072,
      "text": "전망탑 · Tháp quan sát. Đi từ rừng núi đến đài kính trên cao: một hành trình gợi Namsan."
    },
    {
      "id": "terrace",
      "x": 1120,
      "y": 3296,
      "text": "전망 · Tầm nhìn. Bậc thang dẫn lên sân ngắm cảnh; hãy theo lan can để nhìn lại đường rừng."
    },
    {
      "id": "wheel",
      "x": 3328,
      "y": 3104,
      "text": "관람차 · Vòng quay ngắm cảnh. Những cabin kính và khung thép trắng tạo điểm hẹn giữa công viên hoa."
    },
    {
      "id": "carousel",
      "x": 3968,
      "y": 3072,
      "text": "회전목마 · Trò quay vòng. Mái cánh hoa dẫn lối từ khu vui chơi đến vườn nghỉ và nhà khám phá."
    },
    {
      "id": "creative-hall",
      "x": 4016,
      "y": 3584,
      "text": "발견 · Khám phá. Nhà kính, khu vườn và những hình khối khoa học gợi trí tò mò của người khám phá."
    },
    {
      "id": "park-entry",
      "x": 3552,
      "y": 3576,
      "text": "입구 · Lối vào. Chọn nhánh vòng quay, vườn hoa hay nhà khám phá rồi gặp nhau ở quảng trường."
    },
    {
      "id": "station",
      "x": 2240,
      "y": 2976,
      "text": "역 · Nhà ga. 기차 · Tàu. Hãy dùng lối gỗ được đánh dấu để băng qua đường ray."
    },
    {
      "id": "coast-viewdeck",
      "x": 2752,
      "y": 3808,
      "text": "전망대 · Sàn ngắm biển. Bậc thang phía trước dẫn lên sân; lối đi ở phía nam nối quán cà phê và cầu."
    },
    {
      "id": "cafe",
      "x": 2656,
      "y": 3520,
      "text": "카페 · Quán cà phê. 바다 · Biển. Nghỉ dưới mái kính và nhìn mặt nước từ đường dạo."
    },
    {
      "id": "bridge",
      "x": 2896,
      "y": 3680,
      "text": "다리 · Cầu. Thép và kính nối hai phía lòng nước; lối đi bộ tách khỏi đường ray."
    },
    {
      "id": "jeju-court",
      "x": 1830,
      "y": 4800,
      "text": "초가 · Nhà mái tranh. Đá basalt, tường thấp và mái buộc dây gợi cách cư dân Jeju thích nghi với gió."
    },
    {
      "id": "oreum",
      "x": 2240,
      "y": 4464,
      "text": "오름 · Đồi núi lửa. 귤 · Quýt. Đá núi lửa và cây trái tạo nên bản sắc vườn Windstone."
    },
    {
      "id": "lookout",
      "x": 2736,
      "y": 4352,
      "text": "해안 · Bờ biển. Vách basalt đen gặp sóng xanh; từ sàn ngắm cảnh hãy nhìn đường đi ven đảo."
    },
    {
      "id": "nature-centre",
      "x": 2464,
      "y": 4864,
      "text": "자연 · Thiên nhiên. Tìm ba mẫu đá ở sân để khám phá dấu vết dung nham nguội."
    }
  ],
